{
  "compilerOptions": {

    "module": "commonjs",

    "target": "es2019",

    "moduleResolution": "node",

    "rootDir": "./src",

    "outDir": "./dist",

    "experimentalDecorators": true,

    "emitDecoratorMetadata": true,

    "esModuleInterop": true,

    "strict": false,

    "skipLibCheck": true,

    "types": ["node"]

  },

  "include": [
    "src/**/*"
  ]
}